# File: systemd/finance-fetch.service

[Unit]
Description=Finance Data Fetcher
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
EnvironmentFile=${ENV_ROOT}/.env
WorkingDirectory=${ENV_ROOT}
ExecStart=${ENV_VENV}/bin/python -m finance

[Install]
WantedBy=multi-user.target
